<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PclModpackUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：内容延伸到标题栏，配合 Mica 材质 -->
        <Grid x:Name="AppTitleBar">
            <TextBlock x:Name="AppTitle"
                       Text="PCL 整合包更新器"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center" />
        </Grid>

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsTitleBarAutoPaddingEnabled="False"
                             OpenPaneLength="180"
                             SelectionChanged="Nav_OnSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="更新" Tag="home" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>

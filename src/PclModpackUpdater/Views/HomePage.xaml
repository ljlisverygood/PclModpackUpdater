<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PclModpackUpdater.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="36,12,36,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="整合包更新"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="把最新整合包下载到你选择的 PCL 目录并保存为 modpack.zip，PCL 启动时会自动识别并提示安装。本程序可安装在任意位置，首次使用时选择 Plain Craft Launcher.exe 所在文件夹即可。"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                     Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="更新源"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBox Header="更新源（后端服务地址 http://主机:端口，或 zip 直链；可填多个镜像，每行一个，按顺序尝试）"
                             PlaceholderText="http://your-server:8080 或 https://…/modpack.zip"
                             Text="{x:Bind ViewModel.UrlsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="96"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <TextBox Header="版本清单 version.json 地址（可选，填写后只在远端有变化时才下载整包）"
                             PlaceholderText="https://example.com/modpack/version.json"
                             Text="{x:Bind ViewModel.VersionUrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="PCL 所在文件夹（modpack.zip 将下载到这里）"
                                 Text="{x:Bind ViewModel.PclDirectoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseFolderCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.OneClickUpdateCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                <TextBlock Text="一键更新" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.CheckCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="16" />
                                <TextBlock Text="检查更新" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.DownloadCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="16" />
                                <TextBlock Text="下载整合包" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.CancelDownloadCommand}"
                                Visibility="{x:Bind ViewModel.CancelVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                                <TextBlock Text="取消" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="下载进度"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"
                                 Maximum="100"
                                 IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本地状态"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LocalStateText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="打开文件夹" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.LaunchPclCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                                <TextBlock Text="启动 PCL" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
